# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

[*.{yml,yaml,jsonc}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
trim_trailing_whitespace = false

[*.sql]
indent_style = space

[pnpm-lock.yaml]
indent_style = space

[apps/gateway/drizzle/meta/*.json]
indent_style = space
